<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: devops (Docker client + Git (JGit/Shell) + GitHub API + Nexus)</name>

    <artifactId>z-util-devops</artifactId>

    <dependencies>

        <!-- z-util-core 提供 StringUtil / ArchUtils 等基础工具 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.kohsuke/github-api -->
        <dependency>
            <groupId>org.kohsuke</groupId>
            <artifactId>github-api</artifactId>
        </dependency>

        <!-- GitLab4j 整条已删（2026-10-01）：全仓 src 对 org.gitlab4j 零 import（大小写不敏感
             grep 复核），模块名里的 Git 清单是 JGit/Shell/GitHub，从来没有 GitLab 面；
             它传递拖入的 jersey-client/hk2 全家/mimepull/jersey-apache-connector 等 24 个 jar
             已随 tree 实测消失。将来真要接 GitLab 再按需加回。 -->

        <!-- OkHttp：用于替换 unirest-java（unirest 1.4.9 内置 httpclient 4.5.4 有 CVE-2020-13956） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- JGit: 纯 Java 实现的 git 操作库 -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>5.13.4.202507202350-r</version>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
            <version>${revision}</version>
        </dependency>

    </dependencies>

</project>
