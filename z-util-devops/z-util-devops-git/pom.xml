<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util-devops</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: devops :: git (Git (JGit/Shell) + GitHub API wrappers)</name>

    <artifactId>z-util-devops-git</artifactId>

    <dependencies>

        <!-- z-util-core 提供 StringUtil 等基础工具 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
            <version>${revision}</version>
        </dependency>

        <!--
            github-api（org.kohsuke.github-api）v0 切前是 GitHub REST 的主入口；
            现改为自研 GithubHttpClient（okhttp + parser-json）—— 见
            _doc/001_arch/github-api-migration.md。传递依赖释放 20+ 个 jar
            （commons-lang3 / okio / commons-codec / commons-io 等），把
            Dependabot HIGH 数量从 ~63 砍到 ~0。
        -->

        <!-- JGit: 纯 Java 实现的 git 操作库 -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>5.13.4.202507202350-r</version>
        </dependency>

        <!-- OkHttp：GitHub REST 客户端（GithubHttpClient） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

    </dependencies>

</project>
