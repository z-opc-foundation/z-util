<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>z-util-codegen</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <name>z-util :: codegen :: it</name>
    <description>跨模块集成测试：注解处理器在 test 域真实跑一遍</description>
    <artifactId>z-util-codegen-it</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-codegen-annotations</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-codegen-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-codegen-bean</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-codegen-mapper</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- slf4j-api：@ZSlf4j 生成的 logger 字段要落到真实类型上 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <!-- 处理器走 annotationProcessorPaths（独立类加载器）；
                         -XDaccessInternalAPI 让 javac 把内部包开放给处理器类加载器，
                         否则引擎读不到 javac AST，注入成员一步都走不了。 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-codegen-core</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-codegen-annotations</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-codegen-bean</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-codegen-mapper</artifactId>
                            <version>${revision}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs combine.children="append">
                        <arg>-XDaccessInternalAPI</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
