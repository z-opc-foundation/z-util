<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: proxy (JDK/CGLIB dynamic proxy + self-made class file bytecode model)</name>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-util</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-util-proxy</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cglib</groupId>
            <artifactId>cglib</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- z-util-bridge（2026-10-01 拆出）：class-as-runtime-product 能力
             （CFJavaCompiler + SourceProxyFactory + EntryWeaver + AspectToHookAdapter 等）单独成模块，
             避免 reactor 形成 proxy→core→aop→proxy 循环；proxy 主域不直接用 asm，依赖在 bridge。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-bridge</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- javax.annotation-api 已删（2026-10-01）：src 对 javax.annotation 零引用；
             @PostConstruct 等注解的唯一使用方 z-util-ioc 自己已显式声明。 -->

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>

        <!--测试-->

        <!-- javassist / jol-core 均为 test 作用域（2026-10-01 量过）：src/main 对两者零 import
             （自研 class file 模型替代了 javassist 的位置），只有 test 下的实验类在用；
             挂 compile 纯属把实验件漏进消费方传递树。沙盒模块 z-util-zex 的 main 在用
             这两件，已改为在它自己的 pom 里显式声明，不再靠本模块的 compile 传递。 -->
        <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <scope>test</scope>
        </dependency>

        <!--https://juejin.im/post/5edae70551882543194ed3e1-->
        <dependency>
            <groupId>org.openjdk.jol</groupId>
            <artifactId>jol-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- javaparser 降为 test 作用域（2026-10-01 量过）：src/main 零 import、仅 test 下
             5 个实验类在用；main 域真正吃 javaparser 的是 z-util-source（它自己已显式声明）。 -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>