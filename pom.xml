            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>fontbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>xmpbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>preflight</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <!-- Apache POI (升级到 5.5.1，修复 CVE-2022-26336 等历史 OOB 漏洞；保持 poi-ooxml-full 与 poi 一致) -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml-full</artifactId>
                <version>${poi.version}</version>
            </dependency>


            <!-- jsoup (1.23.x 修复 CVE-2024-46506 等) -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <!-- github-api (升级到 1.321) -->
            <dependency>
                <groupId>org.kohsuke</groupId>
                <artifactId>github-api</artifactId>
                <version>${github-api.version}</version>
            </dependency>

            <!-- protobuf-java 的 managed 条目删掉：地板按坐标直接钉 com.google.protobuf:protobuf-java
                 = 3.25.5，与本仓迁前那一格相同。原来这条是给 mysql-connector-j 拉入的旧版做
                 「强制升级 transitive」用的，父链下发同样按坐标改写传递版本，作用一字没少。 -->

            <!-- ============================================================ -->
            <!-- 传递依赖连贯性锚点（迁入 z-boot-parent 时**量出来**的 25 格）   -->
            <!-- 迁后第一遍 tree 实测漂了 27 个坐标，全部是"本仓没钉、由上游 pom 自己带"的传递件：
                 继承来的 DM 会改写**传递依赖**的版本，而地板对这些格的口径比带它们的那几个上游库
                 自己声明的更旧（objenesis 3.3→2.6、kotlin-stdlib 1.8.21→1.6.21、
                 commons-compress 1.28.0→1.26.0、commons-collections4 4.5.0→4.4、asm 9.7→9.2、
                 javaparser-core 3.28.2→3.23.1 …），并把 junit 整族压到 junit-bom 的 5.9.3 ——
                 那意味着聚合件 junit-jupiter 还是 5.11.4、它的 api/engine 却成 5.9.3，测试台混版本。
                 这 25 条**不是版本属性表**（CEO 要拆的是那张表）：它们不声明"本仓用什么"，
                 只是把每个坐标钉回"带它的那个上游库自己要求的版本"，一条对一条实测漂移，
                 并且刻意写字面量、不再新增 property。
                 判据：写完复跑 tree，除下面明确认账的 4 行外漂移为 0。
                 ⚠ 必须逐条写**直接**条目：地板的 junit-bom/jackson-bom/spring-boot-dependencies
                 是 import 进来的，而"继承来的直接 DM"压过"本仓 import 的 BOM"
                 （z-boot README 消费模型第 5 条实测的形状，这里用的是同一个机制的反方向）。
                 ============================================================ -->
            <!-- javaparser：本仓 DM 直钉 symbol-solver-core 3.28.2，它带的 core 被地板压成 3.23.1
                 ⇒ 同族两套版本；core 必须跟着 3.28.2（main 域真正吃它的是 z-util-source；
                 z-util-proxy 2026-10-01 起只有 test 域在用） -->
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <!-- guava 33.6.0-jre 自带的两个纯注解件 -->
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.47.0</version>
            </dependency>
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>3.55.1</version>
            </dependency>
            <!-- okhttp 4.12.0 声明 okio 3.6.0（地板要 3.9.0）；kotlin-stdlib 是 okhttp 的运行期 -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>3.6.0</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-jvm</artifactId>
                <version>3.6.0</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>1.8.21</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-common</artifactId>
                <version>1.9.10</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk7</artifactId>
                <version>1.8.21</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>1.8.21</version>
            </dependency>
            <!-- kryo 5.5.0 要求 objenesis 3.x；地板的 2.6 是 Objenesis 1.x/2.x 时代的口径 -->
            <dependency>
                <groupId>org.objenesis</groupId>
                <artifactId>objenesis</artifactId>
                <version>3.3</version>
            </dependency>
            <!-- z-util-proxy 直钉 asm 9.7；其余 4 个模块经 javaparser 传递拿到的 asm 被地板压成 9.2 -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>9.7</version>
            </dependency>
            <!-- poi 5.5.1 / pdfbox 3.0.8 自己声明的 commons-*：地板一律更旧 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.28.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>4.5.0</version>
            </dependency>
            <!-- ⚠ 迁前这三格 commons-* 在本仓内部就是**分叉**的：devops 经 jgit/github-api 拿
                 commons-io 2.16.1、commons-codec 1.11、commons-logging 1.2；office 经 poi/pdfbox 拿
                 2.21.0 / 1.20.0 / 1.4.0。一条全局 DM 只能表达一个值 ⇒ 取**较高**那一格：
                 谁都不被降到自己上游库声明之下；代价是 devops 侧这三行往上漂 ——
                 这是明确认账的改动（commons-io 2.16.1→2.21.0、commons-codec 1.11→1.20.0、
                 commons-logging 1.2→1.4.0），不是漂移。 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.21.0</version>
            </dependency>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.20.0</version>
            </dependency>
            <dependency>
                <groupId>commons-logging</groupId>
                <artifactId>commons-logging</artifactId>
                <version>1.4.0</version>
            </dependency>
            <!-- httpclient/httpcore：地板（经 spring-boot-dependencies import）把它们抬到
                 4.5.14 / 4.4.16，而**那条受管条目自带 commons-logging 通配 exclusion** ⇒ 实测
                 z-util-devops 树里 commons-logging 整根消失（jcl-over-slf4j 也没人补），
                 httpclient 运行期就是 NoClassDefFoundError: org/apache/commons/logging/LogFactory。
                 按坐标写直接条目把面值顶回迁前那一格，同时把那条 exclusion 一起顶掉（就近整条覆盖）。 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>4.5.13</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpcore</artifactId>
                <version>4.4.13</version>
            </dependency>
            <!-- JUnit 家族：本仓 DM 原先只直钉 junit-jupiter / junit-vintage-engine 两件 5.11.4，
                 api/engine/params/platform-commons/platform-engine/opentest4j 全靠它们的 pom 带；
                 地板 import 的 junit-bom 是 5.9.3 ⇒ 不补这 6 条就是"聚合件 5.11.4 + 平台 1.9.3"
                 的混版本测试台（38 个模块全中）。 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.opentest4j</groupId>
                <artifactId>opentest4j</artifactId>
                <version>1.3.0</version>
            </dependency>
            <!-- junit:junit 4.13.2（经 vintage engine）声明 hamcrest-core 1.3；地板压成 2.2 并
                 额外带进 org.hamcrest:hamcrest —— 1.3 才是迁前 38 个模块树里的那一件。 -->
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest-core</artifactId>
                <version>1.3</version>
            </dependency>
            <!-- 明确**不**钉的一格（这一行漂移是认过账的）：
                 com.fasterxml.jackson.module:jackson-module-jaxb-annotations 2.12.2 → 2.18.9。
                 迁前它是 2.12.2，而本仓 jackson-databind/core/annotations 全在 2.18.9 —— 那才是错的组合；
                 地板的 jackson-bom 按本仓自己的 ${jackson.version} 插值，把它抬进同族 ⇒ 接受。 -->


        </dependencies>
    </dependencyManagement>

    <!-- ============================================================== -->
    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承）：   -->
    <!--   * junit-jupiter        5.11.4 — JUnit 5 新测试（API + 引擎）     -->
    <!--   * junit-vintage-engine 5.11.4 — 老 JUnit 4 测试（org.junit.Test）-->
    <!--     跑在 JUnit 5 平台上                                            -->
    <!-- 子模块一律不再各自声明这两件（DSL/IOC/ML/visualization 等 42 处       -->
    <!-- 重复声明已删）；版本/作用域仍由上面 DM 统一下发。                   -->
    <!-- 注意两件事：                                                       -->
    <!--   1. parent <dependencies> 是继承直供，与 <dependencyManagement>    -->
    <!--      （只钉版本、子模块仍要写）不是一回事 —— 要的就是前者。          -->
    <!--   2. 这是单向门：子模块继承后无法"退出"。本仓全部是带测试的工具件，   -->
    <!--      全量口径正是想要的；test 作用域也绝不外溢到消费方。             -->
    <!-- ============================================================== -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>${compile.version}</source>
                    <target>${compile.version}</target>
                    <encoding>utf-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.17.1</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version> <!-- 使用最新稳定版 -->
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <!-- 绑定到 verify，确保 deploy 到任何仓库（含 Central）时都附带 sources.jar -->
                        <phase>verify</phase>
                        <goals>
                            <!-- 生成源码包并附加到构建结果中 -->
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <!-- 「消费模型」步骤 7 的判据是**本仓中央上现在是什么形状**，不是全组织统一成 0：
                     repo1 实测 z-util:1.0.13 发布的是 `resolveCiFriendliesOnly` 的产物（656 行、
                     `<parent>` 计数 0、`com.zifang` 计数 0、带完整 <dependencyManagement> 与
                     <properties>、含 42 处 ${} 引用但**全部由自家 properties/profile 解析**）；
                     叶子件 z-util-core:1.0.13 则是 88 行、`<parent>` 计数 1（→ io.github.yuku123:z-util:1.0.13）、
                     0 处 ${}。⇒ 按「本来就发带 <parent> 的扁平 pom 保持它自己的 flattenMode 不动」那一档处理：
                     模式与版本都**不改**（尤其不换成 oss —— oss 会把 <dependencyManagement> 整个删掉，
                     z-util 这棵 umbrella 对外供的就是这张表，换了就是换交付物）。
                     代价说清楚：根 pom 发布件的 `<parent>` 计数因此从 0 变成 1（→ z-boot-parent:1.0.19），
                     这条链子在 repo1 上读得动（已 ranged GET 200 复核），并由 repo1-only 那遍复跑兜住。
                     也正因为不换成 oss，上面自家模块的 DM 面值必须写 `${revision}` 不能写
                     `${project.version}`（本插件只展开 revision/sha1/changelist）。 -->
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>sandbox</id>
            <modules>
                <module>z-util-zex</module>
            </modules>
        </profile>

        <!-- ============================================================== -->
        <!-- `mvn deploy -Pcentral` 走 Maven Central（Sonatype Central Portal）-->
        <!-- 同时改写 distributionManagement、追加 gpg/javadoc/central-publishing -->
        <!-- ============================================================== -->
        <profile>
            <id>central</id>
            <properties>
                <!-- true 跳过 javadoc 生成（用于本地 dry-run）；真发 Central 时改为 false -->
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <!-- true 跳过 GPG 签名（用于本地 dry-run）；真发 Central 时改为 false -->
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 中央发布场景下，禁用 maven-deploy-plugin 的 default-deploy，
                         改由 central-publishing-maven-plugin 接管（不会重复 deploy 到 snapshotRepository） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <!-- Maven Central 强制要求 javadoc.jar；用 doclint=none 规避 Java 8+ 的 HTML5 校验 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <source>${compile.version}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- GPG 签名：passphrase 通过环境变量 CENTRAL_GPG_PASSPHRASE 传入 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central Portal 上传插件（替代老的 nexus-staging-maven-plugin） -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- waitUntil=uploaded：每个子模块 deploy 完只等上传成功不等 published -->
                            <waitUntil>uploaded</waitUntil>
                            <!-- waitMaxTime=1800s（30 分钟）：中央 Portal validation 可能慢 -->
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============================================================== -->
        <!-- dry-run profile：跳过 javadoc/gpg/central-publishing，便于本地验证 -->
        <!-- ============================================================== -->
        <profile>
            <id>central-dryrun</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <central.gpg.skip>true</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>