        <!-- 地板 guava 32.0.0-jre，本仓 33.6.0-jre。 -->
        <guava.version>33.6.0-jre</guava.version>
        <cglib.version>3.3.0</cglib.version>
        <!-- gson.version 这一格删掉了：迁前它**谁也没挂** —— 全仓 47 个 pom 里没有一条 gson 依赖，
             0 个 java 文件 import com.google.gson，纯粹是属性表里的死账（不在本次"版本口径"的账上，
             删它不改任何解析结果）。 -->
        <!-- 地板 jackson 2.18.6（并经 jackson-bom import 整族），本仓 2.18.9。 -->
        <jackson.version>2.18.10</jackson.version>
        <!-- okhttp.version / netty.version / protobuf-java.version 三格删掉了：
             地板面值 4.12.0 / 4.1.138.Final / 3.25.5 与本仓迁前**逐格相同** ⇒ 键与对应的
             <dependencyManagement> 条目一起删，改由父链下发（迁移后 tree 里这几族版本一件没动）。 -->
        <antlr.version>4.13.2</antlr.version>
        <jsoup.version>1.23.1</jsoup.version>
        <!-- 地板 javassist 3.24.1-GA，本仓 3.32.0-GA（高版本默认开启 module 支持，Java 17+ 兼容）。 -->
        <javassist.version>3.32.0-GA</javassist.version>
        <jol.version>0.17</jol.version>
        <!-- 地板 javaparser 3.23.1，本仓 3.28.2。 -->
        <javaparser.version>3.28.2</javaparser.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <poi.version>5.5.1</poi.version>
        <github-api.version>1.330</github-api.version>

        <!-- Central Portal 上传凭证（由环境变量 CENTRAL_USERNAME / CENTRAL_TOKEN 注入） -->
        <centralPortalUrl>https://central.sonatype.com</centralPortalUrl>
        <centralPublishingServerUrl>https://central.sonatype.com</centralPublishingServerUrl>
        <!-- 跳过 GPG 签名（本地 dry-run 时打开；真发 Central 时保持 false） -->
        <central.gpg.skip>false</central.gpg.skip>
