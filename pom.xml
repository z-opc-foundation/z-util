        <!-- ============================================================== -->
        <!-- `mvn deploy -Pcentral` 走 Maven Central（Sonatype Central Portal）-->
        <!-- 同时改写 distributionManagement、追加 gpg/javadoc/central-publishing -->
        <!-- ============================================================== -->
        <profile>
            <id>central</id>
            <properties>
                <!-- true 跳过 javadoc 生成（用于本地 dry-run）；真发 Central 时改为 false -->
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <!-- true 跳过 GPG 签名（用于本地 dry-run）；真发 Central 时改为 false -->
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 中央发布场景下，禁用 maven-deploy-plugin 的 default-deploy，
                         改由 central-publishing-maven-plugin 接管（不会重复 deploy 到 snapshotRepository） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <!-- Maven Central 强制要求 javadoc.jar；用 doclint=none 规避 Java 8+ 的 HTML5 校验 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <source>${compile.version}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- GPG 签名：passphrase 通过环境变量 CENTRAL_GPG_PASSPHRASE 传入 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central Portal 上传插件（替代老的 nexus-staging-maven-plugin） -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- waitUntil=uploaded：每个子模块 deploy 完只等上传成功不等 published -->
                            <waitUntil>uploaded</waitUntil>
                            <!-- waitMaxTime=1800s（30 分钟）：中央 Portal validation 可能慢 -->
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============================================================== -->
        <!-- dry-run profile：跳过 javadoc/gpg/central-publishing，便于本地验证 -->
        <!-- ============================================================== -->
        <profile>
            <id>central-dryrun</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <central.gpg.skip>true</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
