<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>z-util-serialize</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>z-util-serialize-it</artifactId>
    <packaging>jar</packaging>
    <name>z-util :: serialize :: it (cross-module integration tests)</name>
    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-serialize-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-serialize-formats</artifactId>
        </dependency>
        <!-- codegen: 注解处理器 + 运行时 CodecRegistry -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-serialize-codegen</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <!-- 将 codegen 和 schema 作为 annotation processor -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-serialize-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-serialize-schema</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
