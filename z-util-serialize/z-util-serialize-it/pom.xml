<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>z-util-serialize</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>z-util-serialize-it</artifactId>
    <packaging>jar</packaging>
    <name>z-util :: serialize :: it (cross-module integration tests)</name>
    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-serialize-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-serialize-formats</artifactId>
        </dependency>
        <!-- codegen: 注解处理器 + 运行时 CodecRegistry -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-serialize-codegen</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- kryo 仅供跑分工具 ZSerializeVsKryoBench 使用（手搓 main() 计时，非 JMH）。
             钉 test scope：它原先挂在 z-util-serialize-benchmarks 的 compile 域，
             等于把 Kryo 作为传递依赖塞进每个引该件的消费者。 -->
        <dependency>
            <groupId>com.esotericsoftware</groupId>
            <artifactId>kryo</artifactId>
            <version>5.7.0</version>
            <scope>test</scope>
        </dependency>
        <!-- junit:junit 直条已换（2026-10-01）：直挂 JUnit4 会让 surefire 去解析 surefire-junit4
             provider——本机没缓存、离线/证书受限环境直接卡死。改用全仓既定的 vintage-engine 路线
             （platform provider 各模块已缓存）：@Test/@Before 用例零改动，junit:junit 4.13.2
             经 vintage 传递仍在。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <!-- 将 codegen 和 schema 作为 annotation processor -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-serialize-codegen</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.yuku123</groupId>
                            <artifactId>z-util-serialize-schema</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
