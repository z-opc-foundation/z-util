<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: aop (aspect framework: @Intercept/Advise API + Aspect SPI + self-made/JDK runtime proxy + source-gen proxy)</name>

    <artifactId>z-util-aop</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            z-util-aop = 切面全家（2026-10-02 自 z-util-bc 再拆出）：
            - com.zifang.util.aop            高层 AOP API（@Intercept/Advise/ProxyFactory/ClassLevelProxy）
            - com.zifang.util.aop.aspects    Aspect SPI（Aspect/SimpleAspect/TimeRecordAspect）
            - com.zifang.util.aop.proxy      自研/JDK 运行期代理（ProxyUtil/ClassProxyFactory/JdkProxyFactory）
            - com.zifang.util.aop.aopgen     源码生成代理（SourceProxyFactory/MethodHook/AspectToHookAdapter）

            底层用 z-util-bc：仅 aopgen → bc.compile（内存编译）一条边，单向下沉；
            bc 不回依赖本模块（字节码引擎不认识切面框架）。

            cglib 依赖已删（2026-10-02）：CglibProxyFactory/CglibInterceptor 由自研
            ClassProxyFactory（SourceProxyFactory 内存编译子类代理）替代，零三方依赖。
            surefire 的 add-opens 参数同步删除：项目是 Java 8，无模块系统，该参数仅 JDK 9+ 需要。
        -->

        <!-- ProxyUtil 需要 ClassLoaderUtil.getContextClassLoader() -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-bc</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
