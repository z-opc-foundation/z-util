<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: aop (@Advise / Intercept interceptor + ProxyFactory)</name>
    <artifactId>z-util-aop</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <!-- slf4j-api 整条已删（2026-10-01）：src 对 org.slf4j 零引用，
             日志面全走 z-util-core 下发的 log4j 桥（本模块连 core 都不依赖，纯无日志）。 -->

        <!-- z-util-bridge（2026-10-01 拆出）：SourceProxyFactory / AspectToHookAdapter
             / MethodHook + Aspect 都在这里，与 z-util-proxy 不直接依赖，
             避免 reactor 形成 proxy→core→aop→proxy 循环。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-bridge</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
</project>
