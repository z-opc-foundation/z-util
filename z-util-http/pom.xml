<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: http</name>
    <description>aggregate shell over http-core/http-proxy/http-server, kept for classpath compatibility</description>

    <artifactId>z-util-http</artifactId>

    <dependencies>
        <!-- R1 三拆（2026-10-10）：本坐标不再携带任何源码，只做聚合壳。
             存量消费方继续引 z-util-http 可拿到全量 classpath；
             新消费方（各业务仓的对外 SDK 客户端）请只引 z-util-http-core，
             传递依赖收敛在 okhttp/okhttp-sse/slf4j/z-util-parser-json，不含 z-util-core / z-util-aop。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-http-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-http-proxy</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-http-server</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
</project>
