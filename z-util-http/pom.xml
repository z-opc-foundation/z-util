<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: http (annotation-style HTTP client + curl parser + simple HTTP server + Netty IM samples)</name>

    <artifactId>z-util-http</artifactId>

    <dependencies>
        <!-- OkHttp HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- OkHttp SSE (Server-Sent Events) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
        </dependency>

        <!-- netty-all 整条已删（2026-10-01）：src 对 io.netty 零引用。模块名里的 "Netty IM
             samples" 是 src/main/resources 下的教程 .java（下面 resources 排除规则根本不打包、
             Maven 也不编译它们），为此挂整个 netty-all 纯属 IDE 观感。真要恢复 IM 示例再按需加回。 -->

        <!-- SLF4J 日志门面（HttpExecutor 用 LoggerFactory） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JSON 处理 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- JAXB API (Java 8+ 需要单独引入) -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 内部依赖 -->
        <!-- z-util-aop (2026-10-02)：HttpServerProxy 用 aop.proxy.ProxyUtil -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-aop</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 基础工具（DedaoC 等 dedao 抓取 demo 测试需要 FileUtil） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- 排除 resources 下的演示代码（Netty 教程示例），不打包到生产 JAR -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
