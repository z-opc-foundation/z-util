<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util-expr</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

<name>z-util :: expr :: js</name>
    <description>self-made JS engine + PlayScript reference</description>

    <artifactId>z-util-expr-js</artifactId>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 排除 resources 下的演示代码（SpEL 等教程示例），不打包到生产 JAR -->
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <!-- 同上：.java 由 maven-compiler-plugin 编译成 .class 进包，源文件本身不该
                     再复制一份进运行时 JAR。缺这个 exclude 时 jar 里会同时躺着 25 个 .java
                     （2026-10-15 从中央已发布的 1.2.6 jar 实测确认）。 -->
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <dependencies>
        <!-- 解析框架依赖（ANTLR 等） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-dsl-kernel</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
</project>
