# ============================================================
# Java / Maven
# ============================================================

# Java 编译产物
*.class
*.jar
*/*.jar

# Maven 构建产物
/build/
/target/
*/target/
**/target/
**/surefire-reports/

# Hive 嵌入式 metastore（部分测试模块用到）
*/metastore_db

# ============================================================
# 编辑器 / IDE 临时文件
# ============================================================

# IntelliJ / JetBrains
.idea/
*.iml

# Eclipse
.project
.classpath
.settings/

# Vim / Emacs 临时文件
*~
*.swp
*.swo
*.bak
*.orig
*.rej
*.tmp

# ============================================================
# 操作系统文件
# ============================================================

# macOS
.DS_Store
**/.DS_Store

# ============================================================
# 日志 / 测试中间产物
# ============================================================

*.log
/logs/
*/logs/
**/logs/
**/log/

# Hadoop MapReduce 输出临时文件（Hive 测试场景）
*.crc
*/input*_output/
**/input*_output/

# ============================================================
# flatten-maven-plugin 中间产物
# ============================================================

.flattened-pom.xml
*.flattened-pom.xml

# ============================================================
# opencode (本地 AI 助手配置)
# ============================================================

.opencode/

# ============================================================
# Maven Central 发布相关：本地凭证 / GPG 密钥环 / staging
# ============================================================

# 本地凭证（Central Portal User Token + GPG passphrase）
.env
.env.local
.env.*

# GPG 密钥环（用 GNUPGHOME 指向 z-util/.gnupg，避免污染 ~/.gnupg）
/.gnupg/

# Maven 中央发布插件临时目录
/target/central-staging/
/target/central-publishing/
/target/central-deferred/
# ===== Git 本地备份目录 (历史塌缩用) =====
.git.bak.*/
