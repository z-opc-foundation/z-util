<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: core (base utilities: collection/string/io/concurrent/crypto/jwt/limiter/breaker/scheduler)</name>

    <artifactId>z-util-core</artifactId>

    <dependencies>

        <!-- SLF4J -> log4j 2.x 实现 -->
        <!-- slf4j-api 自报家门（2026-10-01）：main 里 21 个文件 import org.slf4j，以前靠
             z-util-aop 代发传递件，aop 摘除自用依赖后各使用方一律显式声明（版本由根 DM 下发）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>

        <!-- 移除 log4j-1.2-api：项目使用 SLF4J + log4j2 即可，
             1.2-api 仅在需要兼容 log4j 1.x API 时引入，会干扰 log4j 2.x 配置加载 -->

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Jackson JSR310 模块：支持 java.time 序列化 (LocalDate/LocalDateTime/Instant) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>


        <!-- javax.inject 整条已删（2026-10-01）：src 对 javax.inject 零引用；JSR-330 的唯一
             使用方是 z-util-ioc，它自己已显式声明。需要钉版的消费方仍可吃根 DM 那格锚点。 -->

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
        </dependency>

        <!-- LogContext / LoggableAdvise 依赖（trace + aop 内部模块） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-aop</artifactId>
        </dependency>
    </dependencies>
</project>