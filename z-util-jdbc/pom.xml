<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: jdbc (DataSource/transaction/annotation Mapper/Repository proxy + lightweight ORM)</name>

    <artifactId>z-util-jdbc</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.2.0</version>
            <optional>true</optional>
        </dependency>

        <!-- slf4j-api 自报家门（2026-10-01）：main 9 个文件在用，不再靠 aop 代发（版本由根 DM 下发）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.alibaba/druid -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>

        <!-- https://mvnrepository.com/artifact/javax.persistence/javax.persistence-api -->
        <dependency>
            <groupId>javax.persistence</groupId>
            <artifactId>javax.persistence-api</artifactId>
            <version>2.2</version>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- MyBatis 分页插件（MyBatisPageInterceptor） -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.16</version>
            <optional>true</optional>
        </dependency>

        <!-- z-util-aop (2026-10-02)：JdbcAspect 用 aop.aspects.Aspect，事务代理用 aop.proxy.ProxyUtil -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-aop</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- InMemoryTables: 取数后的内存 join/聚合/函数交给内存 SQL 引擎 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-expr-sql</artifactId>
        </dependency>

        <!-- InMemoryTables.shape: 二维表再交给对象整形语言抬成高维结构 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-expr-obj</artifactId>
        </dependency>

        <!-- OrderCreationIT 需要 distribute（NanoId, SegmentIdGenerator, UuidV7） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-distribute</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- antlr4-runtime 整条已删（2026-10-01）：src 对 org.antlr 零引用。顺带澄清：dsl 的
             g4「动态加载」是纯自研文本解析（G4FileParser 连 antlr 类都不碰），antlr 在 reactor
             内本来就没有任何载体。 -->

        <!-- Test: H2 in-memory database + JUnit 4 via Vintage Engine -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
