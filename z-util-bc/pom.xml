<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: bc (bytecode tools: self-made class file model + ASM weave + in-memory compile)</name>

    <artifactId>z-util-bc</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            z-util-bc = 字节码工具集（2026-10-02 二次拆分后）：
            - 自研 class 文件模型（11+ 属性） + 反编译 + try/catch 控制流
            - ASM 编织 (ChildFirstClassLoader/EntryWeaver/WeaveRecorder)
            - 内存编译 (CFJavaCompiler/BytesJavaFileObject/MapClassLoader)

            原 aop/proxy/aspects/aopgen/interceptor 五包已拆往 z-util-aop
            （com.zifang.util.aop.*，切面框架，底层经 aopgen → compile 单向下沉引用本模块）。

            pattern 不依赖 bc（pattern 是设计模式抽象，不应耦合字节码工具）。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.7</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ct 包测试用 javaparser 反向生成 java 源码；与 proxy 旧 pom 一致声明为 test。
        -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jol-core：jol 包测试用 OpenJDK jol 分析对象布局 -->
        <dependency>
            <groupId>org.openjdk.jol</groupId>
            <artifactId>jol-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        surefire 的 add-opens 参数已删（2026-10-02）：项目是 Java 8，无模块系统，
        该参数仅 JDK 9+ 需要（当时为 cglib 测试所加，cglib 依赖同日移除）。
    -->
</project>