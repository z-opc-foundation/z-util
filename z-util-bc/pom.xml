<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>z-util</artifactId>
        <groupId>io.github.yuku123</groupId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <name>z-util :: bc (bytecode tools: self-made class file model + ASM weave + in-memory compile)</name>

    <artifactId>z-util-bc</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            z-util-bc = 字节码 + 源码工具集（2026-10-02 二次拆分后；同日 source 收编）：
            - 自研 class 文件模型（11+ 属性） + 反编译 + try/catch 控制流
            - ASM 编织 (ChildFirstClassLoader/EntryWeaver/WeaveRecorder)
            - 内存编译 (CFJavaCompiler/BytesJavaFileObject/MapClassLoader)
            - 源码面 bc.source.*：javaparser 解析 + ClassInfo 元模型 + 源码生成/diff
              （2026-10-02 自 z-util-source 收编，包名升级 com.zifang.util.bc.source.*；
              原 compiler 子包为孤岛死码随迁删除，define 契约接口保留）

            原 aop/proxy/aspects/aopgen/interceptor 五包已拆往 z-util-aop
            （com.zifang.util.aop.*，切面框架，底层经 aopgen → compile 单向下沉引用本模块）。

            pattern 不依赖 bc（pattern 是设计模式抽象，不应耦合字节码工具）。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            javaparser：main 域（bc.source 解析 Java 源码）+ ct 包测试反向生成源码共用，
            compile 声明已覆盖测试域可见性。
        -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.7</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- bc.source 测试的 slf4j 绑定（自 z-util-source 迁入） -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jol-core：jol 包测试用 OpenJDK jol 分析对象布局 -->
        <dependency>
            <groupId>org.openjdk.jol</groupId>
            <artifactId>jol-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        surefire 的 add-opens 参数已删（2026-10-02）：项目是 Java 8，无模块系统，
        该参数仅 JDK 9+ 需要（当时为 cglib 测试所加，cglib 依赖同日移除）。
    -->
</project>